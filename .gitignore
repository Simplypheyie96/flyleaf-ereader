node_modules
dist
.DS_Store
*.local
.vercel

# Real env files never travel. The documented example does — the negation must
# come last, or a later broad pattern silently re-excludes it.
.env
.env.*
!.env.example

# Scratch output from the Playwright MCP server, not part of the app.
.playwright-mcp

# The 4MB test book. Generated, not authored — `node audit/fixtures/make-big.mjs`
# grows it from the seed EPUB that IS in the repo, so a clone can rebuild it and
# git never carries 4.2MB of undiffable zip.
app/audit/fixtures/big.epub
