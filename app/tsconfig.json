{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  /* foliate-js is vendored upstream JavaScript, not ours to type-check. Its
     surface is declared by hand in src/vendor/foliate-js.d.ts — that file is
     inside src and IS checked; the .js itself is Vite's business. */
  "exclude": ["src/vendor/foliate-js"]
}
